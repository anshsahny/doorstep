# Doorstep local configuration. Copy to .env and fill in. `.env` is gitignored: never commit it.
# Deployed secrets live in SSM Parameter Store (SecureString), not here.
# This example file must never contain real values for any secret, phone number or chat ID.

# --- AWS (IAM user doorstep-dev via CLI profile `doorstep`; never root credentials) ---
AWS_PROFILE=doorstep
AWS_REGION=us-east-1

# --- Models (Bedrock, us-east-1). Verify with:
#   aws bedrock list-inference-profiles --region us-east-1 --profile doorstep
#   aws bedrock list-foundation-models  --region us-east-1 --profile doorstep
DOORSTEP_MODEL_AGENT=us.amazon.nova-2-lite-v1:0
DOORSTEP_MODEL_PERSONA=us.amazon.nova-micro-v1:0
DOORSTEP_MODEL_VOICE=amazon.nova-2-sonic-v1:0

# --- Hazard profile this deployment runs, and the replay fixture for local drills (optional) ---
# DOORSTEP_PROFILE=heat
# DOORSTEP_ALERT_FIXTURE=data/alerts/2021-06-pqr-excessive-heat-warning.json

# --- Twilio: the `doorstep` SUBACCOUNT only. Never the parent account. ---
TWILIO_SUBACCOUNT_SID=
TWILIO_SUBACCOUNT_TOKEN=
# The US local number bought on the subaccount, E.164 (example: +15035551234)
TWILIO_FROM_NUMBER=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CAPTAIN_CHAT_ID=
# Comma-separated chat IDs of the volunteer accounts (Phase 2)
TELEGRAM_VOLUNTEER_CHAT_IDS=

# --- NWS API needs an identifying User-Agent: "(app-name, contact email)" ---
NWS_USER_AGENT=(doorstep-demo, you@example.com)

# --- App secrets. Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))" ---
CAPTAIN_PASSCODE=
INTERNAL_HMAC_SECRET=
ORIGIN_SECRET_HEADER=

# --- Real-call allowlist (E.164, comma-separated). Enforced in code and by Cedar policy.
# Locally read from here; deployed from SSM /doorstep/call_allowlist.
CALL_ALLOWLIST=
# Phase 0 smoke test 04 calls this number. It must also appear in CALL_ALLOWLIST.
SMOKE_CALL_TO=
# Phase 4: the operator's own phone. Quiet hours are waived for it on `operator_test` incidents
# only (agent/policies/calls.cedar). Must be the first CALL_ALLOWLIST entry (resident r01).
OPERATOR_TEST_NUMBER=
