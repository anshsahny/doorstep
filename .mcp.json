{
  "mcpServers": {
    "strands": {
      "type": "stdio",
      "command": "uvx",
      "args": ["strands-agents-mcp-server"],
      "env": { "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "agentcore": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.amazon-bedrock-agentcore-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "doorstep",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
