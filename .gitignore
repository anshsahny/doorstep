# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# node / web
node_modules/
web/dist/
.vite/

# aws / cdk / agentcore
cdk.out/
.aws-sam/
.bedrock_agentcore/
.bedrock_agentcore.yaml

# local runtime artefacts
.sessions/
*.wav
*.mp3
recordings/
logs/
*.log

# os / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# generated by `agentcore create` for smoke test 03 (scripts/smoke/03_agentcore_hello/run.sh regenerates it)
scripts/smoke/03_agentcore_hello/DoorstepHello/

# drafts and notes for the blog posts (published on builder.aws, not from this repo)
docs/blog/

# regenerated by every `make local-drill --report` run; the gate evidence lives in docs/PROGRESS.md
evals/drill_report.json
evals/cloud_drill_report.json

# generated by make voice-page (API URL of the deployed stack)
web/voice-test/config.js

# eval task-result cache (re-scoring is free; delete to re-run the models)
evals/.cache/

# draw.io SVG export embeds every icon (over the 2 MB pre-commit limit); the .drawio source and PNG are committed
docs/architecture.svg
